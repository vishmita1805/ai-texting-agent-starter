# Required
OPENAI_API_KEY=sk-...

# Optional
OPENAI_MODEL=gpt-4o-mini
PORT=3000
MAX_TURNS=10
SYSTEM_PROMPT=You are a friendly assistant replying over text message. Keep replies short.

# Turn on in production so only real webhook calls are accepted
VALIDATE_TWILIO_SIGNATURE=false
TWILIO_AUTH_TOKEN=
PUBLIC_URL=https://your-app.example.com
